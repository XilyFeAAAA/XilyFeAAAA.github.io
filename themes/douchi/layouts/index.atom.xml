{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ .Site.Title }}</title>
  <link href="{{ .Permalink }}" rel="self" />
  <link href="{{ .Site.BaseURL }}" />
  <id>{{ .Site.BaseURL }}</id>
  <updated>{{ now.Format "2006-01-02T15:04:05Z07:00" }}</updated>
  {{- range first 20 (where .Site.RegularPages "Type" "in" (.Site.Params.mainSections | default (slice "posts"))) }}
  <entry>
    <title>{{ .Title }}</title>
    <link href="{{ .Permalink }}" />
    <id>{{ .Permalink }}</id>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
    <published>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</published>
    <summary>{{ .Summary | plainify }}</summary>
  </entry>
  {{- end }}
</feed>
